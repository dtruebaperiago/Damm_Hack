# Mode local per defecte. CONNECTED exigeix totes les variables de seguretat.
APP_MODE=
LOAD_SIMULATION=
PORT=
HOST=
PUBLIC_ORIGIN=
DB_PATH=
ADMIN_PASSWORD=
HMAC_SECRET=
TYPEFORM_TOKEN=
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# PostgreSQL: DATABASE_URL de Supabase (Session pooler) només al servidor. Buit conserva SQLite.
# POSTGRES_* només són per a Docker local opcional.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DATABASE_URL=

# Signatura de notificacions Typeform: mínim 32 caràcters aleatoris.
TYPEFORM_WEBHOOK_SECRET=

# Supabase: certificat arrel públic inclòs al repositori.
DATABASE_SSL_CA_FILE=app/certs/supabase-ca.crt
